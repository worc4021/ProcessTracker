<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The Web SDK defaults to server GC (a heap per core); a small background service wants workstation GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- 192 MB GC heap cap and non-concurrent GC (resource budget, spec section 12). -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="0xC000000" />
    <RuntimeHostConfigurationOption Include="System.GC.Concurrent" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dashboard is embedded, not served from disk: nothing writable is ever served. -->
    <EmbeddedResource Include="Dashboard\*.*" LogicalName="dashboard/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <ProjectReference Include="..\ProcessTracker.Core\ProcessTracker.Core.csproj" />
    <ProjectReference Include="..\ProcessTracker.Native\ProcessTracker.Native.csproj" />
  </ItemGroup>
</Project>
