{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.ps1"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "curl.exe",
            "args": ["-s", "-f", "--connect-timeout", "1", "--max-time", "2", "-H", "Content-Type: application/json", "--data-binary", "@-", "http://127.0.0.1:47811/api/hooks/pre-tool-use"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
